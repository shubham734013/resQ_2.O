# ResQ Backend Environment Configuration

PORT=5001
CORS_ORIGINS=http://localhost:5173

# Driver duty/GPS tracking: update cadence is restricted to 3–5 seconds.
DRIVER_LOCATION_UPDATE_INTERVAL_MS=4000
DRIVER_LOCATION_STALE_AFTER_MS=15000
DRIVER_LOCATION_MAX_AGE_MS=30000

# ==============================================================================
# Database Configuration (MongoDB Local or MongoDB Atlas)
# ==============================================================================
#
# LOCAL MONGODB:
#   MONGODB_URI=mongodb://127.0.0.1:27017/resq
#
# MONGODB ATLAS SETUP:
#   1. Database User: In Atlas Console -> Database Access, create a database user
#      with 'readWrite' privileges for the target database.
#   2. Network Access: In Atlas Console -> Network Access, whitelist your backend
#      server IP address (or corporate CIDR block).
#   3. URL-Encoding Password: If your password contains special characters like
#      @, :, /, %, ?, #, or &, URL-encode them:
#        @ => %40 | : => %3A | / => %2F | % => %25 | ? => %3F | # => %23 | & => %26
#   4. Connection URI Format:
#      mongodb+srv://<DB_USER>:<URL_ENCODED_PASSWORD>@<CLUSTER_HOST>/<DB_NAME>?retryWrites=true&w=majority
#   5. Verification: Verify connectivity using `npm run audit:db` or start with `npm run dev`.
#
MONGODB_URI=mongodb://127.0.0.1:27017/resq
JWT_SECRET=replace_with_at_least_32_characters_secret_key!
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_refresh_secret_key!

# Bootstrap Administrator Account
RESQ_ADMIN_EMAIL=admin@resq.local
RESQ_ADMIN_PASSWORD=AdminStrongPassword123!

# Google OAuth 2.0 Credentials (matching frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# Microsoft Entra ID (Azure AD) Credentials (matching frontend VITE_MICROSOFT_CLIENT_ID)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
MICROSOFT_REDIRECT_URI=http://localhost:5173

# Dedicated server-side keys. Restrict each key to its API and server usage.
# Legacy fallback supported by the app while migrating existing environments.
GOOGLE_GEOCODING_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
