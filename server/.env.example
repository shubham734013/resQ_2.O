# ResQ Backend Environment Configuration

PORT=5001
CORS_ORIGINS=http://localhost:5173

# Database & Security
MONGODB_URI=mongodb://localhost:27017/resq
JWT_SECRET=replace_with_at_least_32_characters_secret_key!
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_refresh_secret_key!

# Bootstrap Administrator
RESQ_ADMIN_EMAIL=admin@resq.local
RESQ_ADMIN_PASSWORD=AdminStrongPassword123!

# Google OAuth 2.0 Credentials (matching frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# Microsoft Entra ID (Azure AD) Credentials (matching frontend VITE_MICROSOFT_CLIENT_ID)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
MICROSOFT_REDIRECT_URI=http://localhost:5173

# Google Maps Server API Key (for server-side geocoding & routing)
GOOGLE_MAPS_SERVER_API_KEY=

