# ResQ Frontend Environment Variables

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5001/api/v1

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorize JavaScript origin: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# Microsoft Entra ID (Azure AD) Client ID (from Azure Portal -> App registrations)
# Redirect URI: http://localhost:5173 (Single-page application)
VITE_MICROSOFT_CLIENT_ID=
# Authority: https://login.microsoftonline.com/common (for multi-tenant/personal) or specific tenant ID
VITE_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common

# Google Maps JavaScript API key (browser key; restrict by HTTP referrer)
VITE_GOOGLE_MAPS_API_KEY=
# Optional alias if your existing local .env uses this name instead
# VITE_GOOGLE_MAPS_JAVASCRIPT_API_KEY=
# Configure a real Google Map ID for production Advanced Markers; DEMO_MAP_ID is for development
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
